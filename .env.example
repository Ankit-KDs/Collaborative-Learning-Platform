# Application Settings
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=replace-with-a-random-secret-key-32-chars-minimum

# Database Configuration (Defaults to SQLite in instance/ directory)
DATABASE_URL=sqlite:///instance/learning_platform.db

# Faculty Security Gate
TEACHER_INVITE_CODE=replace-with-a-random-invite-code

# Development Data Seeding Gate (Local dev only, keep false in production)
ALLOW_DEMO_SEED=false

# External AI Credentials & Limits (Multi-provider: Gemini / Groq)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=20
AI_DAILY_LIMIT_HINT=20
AI_DAILY_LIMIT_QUIZ=10
AI_DAILY_LIMIT_PATH=5

# Admin Panel & Privacy Controls (Stage 10)
# Set to true only if authorized to inspect private/group chat messages (audit-logged on every view)
ADMIN_CAN_VIEW_CHAT_CONTENT=false
# Optional IP allowlist for admin routes (comma-separated; leave empty to allow all IPs)
ADMIN_IP_ALLOWLIST=
